# Lannent API — environment template (V0)
# Copy to .env and adjust. .env is gitignored; this file is committed.
#
# Each layer owns its own block. Add keys under YOUR heading.

# ── Core ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── V1 · Logging ───────────────────────────────────────────────────────────
LOG_DIR=logs
# How often buffered logs are appended to disk, in ms. This is the
# "at regular intervals" requirement — keep it visible and tunable.
LOG_FLUSH_MS=10000
# Force a flush early if the buffer grows past this many entries.
LOG_BUFFER_LIMIT=100
LOG_RETENTION_DAYS=7

# ── V2 · Error handling ────────────────────────────────────────────────────
# Request timeout before TimeoutInterceptor returns 408, in ms.
REQUEST_TIMEOUT_MS=15000
# Return stack traces to the client. NEVER enable outside local development.
EXPOSE_STACK_TRACES=false

# ── V3 · File upload ───────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_DELIVERABLE_BYTES=52428800
MAX_DOCUMENT_BYTES=5242880
MAX_FILES_PER_REQUEST=10

# ── V4 · Security ──────────────────────────────────────────────────────────
# Comma-separated CORS allow-list. Replaces origin:'*'.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# HMAC signing secret. Generate per environment; never commit the real value.
TOKEN_SECRET=change-me-in-your-local-env-file
TOKEN_TTL_MS=28800000
BODY_LIMIT=1mb

# ── V5 · Router-level middleware ───────────────────────────────────────────
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000
GLOBAL_THROTTLE_LIMIT=100
GLOBAL_THROTTLE_TTL_MS=60000
