# ── Dependencies ───────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Build output ───────────────────────────────────────────────────────────
dist/
build/
out/
*.tsbuildinfo

# ── Test / coverage ────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Secrets and local config ───────────────────────────────────────────────
# .env holds TOKEN_SECRET. The template is committed; the real file never is.
.env
.env.*
!.env.example

# ── Runtime data written by the app ────────────────────────────────────────
# Anchored with a leading slash on purpose. A bare "logs/" or "uploads/" also
# matches back-end/src/modules/logs/ and back-end/src/modules/uploads/, which
# are SOURCE directories — that would silently exclude two layers' code from
# git. This was caught once already; do not un-anchor these.
/back-end/logs/
/back-end/uploads/

# ── Distribution packages ──────────────────────────────────────────────────
# Zipped snapshots handed out to the team. Large, regenerable, and a git repo
# is the wrong place for them.
version-packages/
*.zip
*.tar.gz
*.tgz
*.rar
*.7z

# ── Logs ───────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Editors ────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ─────────────────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store
Thumbs.db
